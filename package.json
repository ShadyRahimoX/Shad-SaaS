{
  "name": "shad-saas-monorepo",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:store": "npm --prefix apps/store run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @shad-saas/db generate",
    "db:push": "pnpm --filter @shad-saas/db push",
    "db:studio": "pnpm --filter @shad-saas/db studio"
  }
}
